rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /metrics/{metricId} {
      allow read, write: if true;
    }
    match /activity_logs/{logId} {
      allow read, write: if true;
    }
    match /admin_settings/{settingId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
